# Copy to .env for local development. In production, set these in the hosting dashboard.

# Neon Postgres connection string. Leave empty locally to use the embedded database in .data/pglite.
DATABASE_URL=

# Where the embedded local database lives (only used when DATABASE_URL is empty).
PGLITE_DIR=.data/pglite

# Admin password hash. Create one with: npm run admin:hash -- 'your password'
ADMIN_PASSWORD_HASH=

# Random string used to hash visitor IPs for rate limiting. Create one with: openssl rand -hex 32
IP_HASH_SALT=

# Contact form email via Resend (https://resend.com). Without these, messages are only stored.
RESEND_API_KEY=
CONTACT_TO_EMAIL=
# Must be an address on a domain verified in Resend.
CONTACT_FROM_EMAIL=

# Cloudflare Turnstile spam check. Without these, only the honeypot and rate limit apply.
PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Photo storage on Vercel Blob (created automatically when a Blob store is linked to the project).
# Without it, uploads are stored in UPLOAD_DIR and served from /uploads.
BLOB_READ_WRITE_TOKEN=
UPLOAD_DIR=.data/uploads
